---
// src/components/AlbumFeature.astro
import SectionHeading from './SectionHeading.astro';

const tracks = [
  { num: "01", title: "Verlos morir", duration: "3:17", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-01.mp3" },
  { num: "02", title: "El dolor", duration: "3:01", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-02.mp3" },
  { num: "03", title: "Por los siglos de los siglos", duration: "3:55", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-03.mp3" },
  { num: "04", title: "Honestidad", duration: "3:37", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-04.mp3" },
  { num: "05", title: "Última palabra", duration: "4:50", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-05.mp3" },
  { num: "06", title: "Espíritu", duration: "4:31", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-06.mp3" },
  { num: "07", title: "Te obsesionas con sentir", duration: "4:04", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-07.mp3" },
  { num: "08", title: "Un ángel disparó", duration: "4:06", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-08.mp3" },
  { num: "09", title: "Azul", duration: "2:39", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-09.mp3" },
  { num: "10", title: "Almas contra el tiempo", duration: "3:07", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-10.mp3" },
  { num: "11", title: "¿Qué tan romántica será la muerte?", duration: "4:33", preview: "https://vault-anttonias.rod.cl/audio/preview/preview-11.mp3" }
];
---

<section class="album-section" id="disco" aria-label="El nuevo álbum: ¿Qué tan romántica será la muerte?">
  <div class="album-container">
    <SectionHeading>¿QUÉ TAN ROMÁNTICA<br />SERÁ LA MUERTE?</SectionHeading>

    <div class="album-grid">
      <!-- Columna Izquierda: Arte de Tapa & Streaming -->
      <div class="album-visual">
        <div class="cover-frame">
          <img 
            src="/assets/images/album-cover-romantica-muerte-1200.jpg" 
            alt="Carátula oficial del álbum ¿Qué tan romántica será la muerte?"
            class="album-cover"
            loading="lazy"
          />
          <div class="cover-reflection" aria-hidden="true"></div>
        </div>

        <div class="streaming-hub">
          <span class="hub-label">ESCUCHAR EN PLATAFORMAS OFICIALES</span>
          <div class="platform-links">
            <a href="https://open.spotify.com/artist/anttonias" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">SPOTIFY</span>
              <span class="platform-arrow">↗</span>
            </a>
            <a href="https://music.apple.com/cl/artist/anttonias" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">APPLE MUSIC</span>
              <span class="platform-arrow">↗</span>
            </a>
            <a href="https://www.youtube.com/@anttonias" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">YOUTUBE</span>
              <span class="platform-arrow">↗</span>
            </a>
            <a href="https://tidal.com" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">TIDAL</span>
              <span class="platform-arrow">↗</span>
            </a>
          </div>
        </div>

        <div class="production-credits">
          <div class="credit-row">
            <span class="credit-role">SELLO</span>
            <span class="credit-name">LOTUS RECORDS / WARNER MUSIC CHILE</span>
          </div>
          <div class="credit-row">
            <span class="credit-role">ESTUDIO</span>
            <span class="credit-name">ESTUDIOS DEL SUR (CHILE)</span>
          </div>
          <div class="credit-row">
            <span class="credit-role">PRODUCCIÓN</span>
            <span class="credit-name">BASTIÁN GRAÑAS & NICOLÁS RESNIKOF</span>
          </div>
          <div class="credit-row">
            <span class="credit-role">MASTERIZACIÓN</span>
            <span class="credit-name">DANIEL OSORIO</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Tracklist Oficial con Micro-Player -->
      <div class="album-narrative">
        <div class="tracklist-wrapper">
          <div class="tracklist-header-row">
            <h3 class="tracklist-heading">TRACKLIST</h3>
            <span class="preview-hint" id="preview-hint">CLIC EN ▶ PARA ESCUCHAR ADELANTO (15s)</span>
          </div>
          <ol class="tracklist" id="tracklist-container">
            {tracks.map(t => (
              <li class="track-item" data-track-item data-num={t.num} data-preview={t.preview}>
                <button 
                  type="button" 
                  class="track-play-btn" 
                  aria-label={`Reproducir adelanto de 15 segundos: ${t.title}`}
                  data-play-trigger
                >
                  <svg class="icon-play" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <svg class="icon-pause" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                  </svg>
                </button>
                <span class="track-num">{t.num}</span>
                <div class="track-info">
                  <div class="track-title-wrap">
                    <span class="track-title">{t.title}</span>
                  </div>
                  <div class="track-progress" aria-hidden="true">
                    <div class="track-progress-bar"></div>
                  </div>
                </div>
                <span class="track-dur">{t.duration}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .album-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .album-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-header {
    max-width: 960px;
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.1em;
    color: var(--color-text-primary);
  }

  .album-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 992px) {
    .album-grid {
      grid-template-columns: 440px 1fr;
      gap: 4rem;
    }
  }

  .album-visual {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cover-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
  }

  .album-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    transition: transform 0.6s var(--ease-cinematic);
  }

  .cover-frame:hover .album-cover {
    transform: scale(1.03);
  }

  .streaming-hub {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hub-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: var(--color-text-faint);
  }

  .platform-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .platform-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    transition: background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease,
                color var(--duration-fast) ease;
  }

  .platform-btn:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--color-text-primary);
  }

  .production-credits {
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .credit-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    gap: 1rem;
  }

  .credit-role {
    color: var(--color-text-faint);
    letter-spacing: 0.15em;
  }

  .credit-name {
    color: var(--color-text-muted);
    text-align: right;
  }

  .album-narrative {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .tracklist-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tracklist-heading {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .preview-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--color-text-faint);
  }

  .tracklist {
    display: flex;
    flex-direction: column;
  }

  .track-item {
    display: flex;
    align-items: center;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color var(--duration-fast) ease,
                padding-left var(--duration-fast) ease;
  }

  @media (hover: hover) {
    .track-item:hover {
      background: rgba(255, 255, 255, 0.02);
      padding-left: 0.75rem;
    }
  }

  .track-item.is-playing {
    background: rgba(255, 255, 255, 0.03);
  }

  .track-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    min-width: 1.85rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text-muted);
    cursor: var(--cursor-pointer, pointer);
    margin-right: 0.65rem;
    padding: 0;
    transition: all var(--duration-fast) ease;
  }

  .track-play-btn:hover,
  .track-play-btn:focus-visible {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--color-text-primary);
    outline: none;
  }

  .track-play-btn .icon-pause {
    display: none;
  }

  .track-item.is-playing .track-play-btn {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
  }

  .track-item.is-playing .track-play-btn .icon-play {
    display: none;
  }

  .track-item.is-playing .track-play-btn .icon-pause {
    display: block;
  }

  .track-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-faint);
    width: 2.2rem;
  }

  .track-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .track-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .track-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
  }

  .track-progress {
    position: relative;
    width: 100%;
    max-width: 240px;
    height: 2px;
    background: rgba(255, 255, 255, 0.06);
    margin-top: 0.25rem;
    border-radius: 1px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .track-item.is-playing .track-progress,
  .track-item.is-buffering .track-progress {
    opacity: 1;
  }

  .track-progress-bar {
    width: 0%;
    height: 100%;
    background: #ffffff;
    transition: width 0.1s linear;
  }

  .track-dur {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-left: 0.5rem;
  }

  /* ==========================================================================
     AJUSTES EXCLUSIVOS PARA MOBILE
     ========================================================================== */
  @media (max-width: 768px) {
    .section-header {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 1.5rem;
    }

    .section-title {
      text-align: center;
      letter-spacing: 0.14em;
    }

    .tracklist-header-row {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.75rem;
    }

    .tracklist-heading {
      text-align: center;
    }

    .preview-hint {
      font-size: 0.58rem;
      text-align: center;
    }

    .track-item {
      padding: 0.5rem 0.15rem;
      transition: none;
    }

    .track-play-btn {
      width: 2rem;
      height: 2rem;
      min-width: 2rem;
      margin-right: 0.5rem;
    }

    .track-num {
      font-size: 0.7rem;
      width: 1.65rem;
    }

    .track-title {
      font-size: 0.88rem;
      letter-spacing: 0.03em;
    }

    .track-dur {
      font-size: 0.7rem;
    }

    .production-credits {
      display: none;
    }
  }
</style>

<script>
  const audio = new Audio();
  audio.preload = 'auto';

  let currentItem: HTMLElement | null = null;
  const trackItems = document.querySelectorAll<HTMLElement>('[data-track-item]');

  function resetAllTracks(resetProgress = true) {
    trackItems.forEach((el) => {
      el.classList.remove('is-playing', 'is-buffering');
      if (resetProgress) {
        const bar = el.querySelector<HTMLElement>('.track-progress-bar');
        if (bar) bar.style.width = '0%';
      }
      const btn = el.querySelector<HTMLButtonElement>('[data-play-trigger]');
      const title = el.querySelector('.track-title')?.textContent?.trim() || '';
      if (btn) btn.setAttribute('aria-label', `Reproducir adelanto de 15 segundos: ${title}`);
    });
  }

  audio.addEventListener('timeupdate', () => {
    if (!currentItem) return;
    const duration = audio.duration && isFinite(audio.duration) ? audio.duration : 15;
    const progress = (audio.currentTime / duration) * 100;
    const bar = currentItem.querySelector<HTMLElement>('.track-progress-bar');
    if (bar) bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
  });

  audio.addEventListener('play', () => {
    resetAllTracks(false);
    if (currentItem) {
      currentItem.classList.remove('is-buffering');
      currentItem.classList.add('is-playing');
      const btn = currentItem.querySelector<HTMLButtonElement>('[data-play-trigger]');
      const title = currentItem.querySelector('.track-title')?.textContent?.trim() || '';
      if (btn) btn.setAttribute('aria-label', `Pausar adelanto de 15 segundos: ${title}`);
    }
  });

  audio.addEventListener('pause', () => {
    if (currentItem) {
      currentItem.classList.remove('is-playing', 'is-buffering');
      const btn = currentItem.querySelector<HTMLButtonElement>('[data-play-trigger]');
      const title = currentItem.querySelector('.track-title')?.textContent?.trim() || '';
      if (btn) btn.setAttribute('aria-label', `Reanudar adelanto de 15 segundos: ${title}`);
    }
  });

  audio.addEventListener('ended', () => {
    resetAllTracks(true);
    currentItem = null;
  });

  audio.addEventListener('error', () => {
    resetAllTracks(true);
    currentItem = null;
  });

  trackItems.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-play-trigger]');
    const previewUrl = item.dataset.preview;

    if (!btn || !previewUrl) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();

      // Si hace clic en el tema que ya está sonando -> pausar
      if (currentItem === item && !audio.paused && !audio.ended) {
        audio.pause();
        return;
      }

      // Si estaba en pausa en este mismo tema -> reanudar
      if (currentItem === item && audio.paused && !audio.ended && audio.src === previewUrl) {
        audio.play().catch(() => {
          resetAllTracks(true);
          currentItem = null;
        });
        return;
      }

      // Cambiar de tema o iniciar desde cero
      audio.pause();
      resetAllTracks(true);

      currentItem = item;
      item.classList.add('is-buffering', 'is-playing');

      audio.src = previewUrl;
      audio.currentTime = 0;
      audio.play().catch((err) => {
        console.warn('Audio preview error:', err);
        resetAllTracks(true);
        currentItem = null;
      });
    });
  });
</script>
