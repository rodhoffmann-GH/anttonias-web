---
// src/components/AlbumFeature.astro

const tracks = [
  { num: "01", title: "Verlos morir", duration: "3:42" },
  { num: "02", title: "El dolor", duration: "4:15" },
  { num: "03", title: "Por los siglos de los siglos", duration: "3:58" },
  { num: "04", title: "Honestidad", duration: "3:30" },
  { num: "05", title: "Última palabra", duration: "4:02" },
  { num: "06", title: "Espíritu", duration: "4:28" },
  { num: "07", title: "Te obsesionas con sentir", duration: "3:51" },
  { num: "08", title: "Un ángel disparó", duration: "4:12" },
  { num: "09", title: "Azul", duration: "5:04" },
  { num: "10", title: "Almas contra el tiempo", duration: "4:36" },
  { num: "11", title: "¿Qué tan romántica será la muerte?", duration: "6:18" }
];
---

<section class="album-section" id="disco" aria-label="El nuevo álbum: ¿Qué tan romántica será la muerte?">
  <div class="album-container">
    <div class="section-header">
      <h2 class="section-title">¿QUÉ TAN ROMÁNTICA SERÁ LA MUERTE?</h2>
    </div>

    <div class="album-grid">
      <!-- Columna Izquierda: Arte de Tapa & Streaming -->
      <div class="album-visual">
        <div class="cover-frame">
          <img 
            src="/assets/images/album-cover-romantica-muerte-3000.jpg" 
            alt="Carátula oficial del álbum ¿Qué tan romántica será la muerte?"
            class="album-cover"
            loading="lazy"
          />
          <div class="cover-reflection" aria-hidden="true"></div>
        </div>

        <div class="streaming-hub">
          <span class="hub-label">ESCUCHAR EN PLATAFORMAS OFICIALES</span>
          <div class="platform-links">
            <a href="https://open.spotify.com/artist/anttonias" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">SPOTIFY</span>
              <span class="platform-arrow">↗</span>
            </a>
            <a href="https://music.apple.com/cl/artist/anttonias" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">APPLE MUSIC</span>
              <span class="platform-arrow">↗</span>
            </a>
            <a href="https://www.youtube.com/@anttonias" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">YOUTUBE</span>
              <span class="platform-arrow">↗</span>
            </a>
            <a href="https://tidal.com" target="_blank" rel="noopener noreferrer" class="platform-btn">
              <span class="platform-name">TIDAL</span>
              <span class="platform-arrow">↗</span>
            </a>
          </div>
        </div>

        <div class="production-credits">
          <div class="credit-row">
            <span class="credit-role">SELLO</span>
            <span class="credit-name">LOTUS RECORDS / WARNER MUSIC CHILE</span>
          </div>
          <div class="credit-row">
            <span class="credit-role">ESTUDIO</span>
            <span class="credit-name">ESTUDIOS DEL SUR (CHILE)</span>
          </div>
          <div class="credit-row">
            <span class="credit-role">PRODUCCIÓN</span>
            <span class="credit-name">BASTIÁN GRAÑAS & NICOLÁS RESNIKOFF</span>
          </div>
          <div class="credit-row">
            <span class="credit-role">MASTERIZACIÓN</span>
            <span class="credit-name">DANIEL OSORIO</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Tracklist Oficial -->
      <div class="album-narrative">
        <div class="tracklist-wrapper">
          <h3 class="tracklist-heading">TRACKLIST</h3>
          <ol class="tracklist">
            {tracks.map(t => (
              <li class="track-item">
                <span class="track-num">{t.num}</span>
                <div class="track-info">
                  <span class="track-title">{t.title}</span>
                </div>
                <span class="track-dur">{t.duration}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .album-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .album-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-header {
    max-width: 960px;
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.1em;
    color: var(--color-text-primary);
  }

  .album-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 992px) {
    .album-grid {
      grid-template-columns: 440px 1fr;
      gap: 4rem;
    }
  }

  .album-visual {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cover-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
  }

  .album-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    transition: transform 0.6s var(--ease-cinematic);
  }

  .cover-frame:hover .album-cover {
    transform: scale(1.03);
  }

  .streaming-hub {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hub-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: var(--color-text-faint);
  }

  .platform-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .platform-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    transition: background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease,
                color var(--duration-fast) ease;
  }

  .platform-btn:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--color-text-primary);
  }

  .production-credits {
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .credit-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    gap: 1rem;
  }

  .credit-role {
    color: var(--color-text-faint);
    letter-spacing: 0.15em;
  }

  .credit-name {
    color: var(--color-text-muted);
    text-align: right;
  }

  .album-narrative {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .tracklist-heading {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tracklist {
    display: flex;
    flex-direction: column;
  }

  .track-item {
    display: flex;
    align-items: center;
    padding: 0.95rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color var(--duration-fast) ease,
                padding-left var(--duration-fast) ease;
  }

  .track-item:hover {
    background: rgba(255, 255, 255, 0.02);
    padding-left: 1rem;
  }

  .track-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-faint);
    width: 2.5rem;
  }

  .track-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .track-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
  }

  .track-act {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-faint);
  }

  .track-dur {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
</style>
