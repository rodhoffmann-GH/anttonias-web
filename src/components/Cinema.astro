---
// src/components/Cinema.astro

const videos = [
  {
    title: "Verlos morir",
    type: "VISUALIZER OFICIAL",
    album: "¿Qué tan romántica será la muerte?",
    year: "2026",
    id: "verlos-morir",
    ytUrl: "https://www.youtube.com/@anttonias",
    image: "/assets/images/anttonias-cementerio-03.jpg"
  },
  {
    title: "El dolor",
    type: "VIDEO OFICIAL",
    album: "¿Qué tan romántica será la muerte?",
    year: "2026",
    id: "el-dolor",
    ytUrl: "https://www.youtube.com/@anttonias",
    image: "/assets/images/anttonias-cementerio-03.jpg"
  },
  {
    title: "Espíritu",
    type: "VIDEO OFICIAL",
    album: "¿Qué tan romántica será la muerte?",
    year: "2026",
    id: "espiritu",
    ytUrl: "https://www.youtube.com/@anttonias",
    image: "/assets/images/anttonias-cementerio-03.jpg"
  },
  {
    title: "Atado a tu sentimiento",
    type: "VIDEO OFICIAL",
    album: "Anttonias (Debut LP)",
    year: "2024",
    id: "atado-a-tu-sentimiento",
    ytUrl: "https://www.youtube.com/@anttonias",
    image: "/assets/images/anttonias-debut-rod-659.jpg"
  }
];
---

<section class="cinema-section" id="videos" aria-label="Videografía oficial">
  <div class="cinema-container">
    <div class="cinema-header">
      <div>
        <span class="section-tag">// CINEMATOGRAFÍA // VIDEOS OFICIALES</span>
        <h2 class="section-title">VIDEOTECA</h2>
      </div>
      <a href="https://www.youtube.com/@anttonias" target="_blank" rel="noopener noreferrer" class="yt-channel-link">
        <span>CANAL OFICIAL DE YOUTUBE</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="cinema-grid">
      {videos.map((v) => (
        <article class="video-card">
          <div class="video-thumbnail-frame">
            <img 
              src={v.image} 
              alt={`Fotograma del video ${v.title} de Anttonias`}
              class="video-thumb"
              loading="lazy"
            />
            <div class="video-scrim" aria-hidden="true"></div>
            <a 
              href={v.ytUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="play-trigger" 
              aria-label={`Reproducir ${v.title} en YouTube`}
            >
              <span class="play-icon" aria-hidden="true">▶</span>
            </a>
          </div>

          <div class="video-meta">
            <div class="video-tags">
              <span class="v-type">{v.type}</span>
              <span class="v-year">{v.year}</span>
            </div>
            <h3 class="video-title">{v.title}</h3>
            <p class="video-album">{v.album}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cinema-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .cinema-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .cinema-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .cinema-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
  }

  .yt-channel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.25rem;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .yt-channel-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .cinema-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .cinema-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cinema-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .video-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    transition: border-color var(--duration-fast) ease;
  }

  .video-card:hover {
    border-color: var(--accent);
  }

  .video-thumbnail-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-black);
  }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    transition: transform var(--duration-slow) var(--ease-cinematic);
  }

  .video-card:hover .video-thumb {
    transform: scale(1.05);
  }

  .video-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(8, 8, 8, 0.45);
    transition: background-color var(--duration-fast) ease;
  }

  .video-card:hover .video-scrim {
    background: rgba(8, 8, 8, 0.2);
  }

  .play-trigger {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(8, 8, 8, 0.8);
    border: 1px solid var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
    transition: transform var(--duration-fast) var(--ease-cinematic),
                background-color var(--duration-fast) ease,
                border-color var(--duration-fast) ease;
  }

  .play-icon {
    font-size: 0.85rem;
    margin-left: 2px;
  }

  .video-card:hover .play-trigger {
    transform: translate(-50%, -50%) scale(1.15);
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--color-text-primary);
  }

  .video-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .video-tags {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  .v-type {
    color: var(--accent);
  }

  .v-year {
    color: var(--color-text-faint);
  }

  .video-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
  }

  .video-album {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
</style>
