---
// src/components/SectionHeading.astro
// Encabezado canónico centrado con ornamento "Filete Degradado" (84px medio, tono hueso)
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`section-heading-wrap ${className}`}>
  <span class="heading-ornament is-left" aria-hidden="true">
    <span class="ornament-line"></span>
    <span class="ornament-dot"></span>
  </span>

  <h2 class="section-title">
    <slot />
  </h2>

  <span class="heading-ornament is-right" aria-hidden="true">
    <span class="ornament-dot"></span>
    <span class="ornament-line"></span>
  </span>
</div>

<style>
  .section-heading-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
    text-align: center;
    margin: 0;
  }

  .heading-ornament {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 3px;
  }

  .ornament-line {
    display: block;
    width: 78px;
    height: 1px;
  }

  .heading-ornament.is-left .ornament-line {
    background: linear-gradient(to right, rgba(240, 237, 230, 0) 0%, rgba(240, 237, 230, 0.85) 100%);
  }

  .heading-ornament.is-right .ornament-line {
    background: linear-gradient(to left, rgba(240, 237, 230, 0) 0%, rgba(240, 237, 230, 0.85) 100%);
  }

  .ornament-dot {
    display: block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: rgba(240, 237, 230, 0.9);
  }

  @media (max-width: 768px) {
    .section-heading-wrap {
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .section-title {
      letter-spacing: 0.1em;
    }

    .ornament-line {
      width: 38px;
    }
  }
</style>
