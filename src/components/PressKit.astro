---
// src/components/PressKit.astro
import SectionHeading from './SectionHeading.astro';
---

<section class="presskit-section" id="contacto" aria-label="Contacto oficial y kit de prensa">
  <div class="presskit-container" id="prensa">
    <SectionHeading>CONTACTO</SectionHeading>

    <div class="presskit-grid">
      <!-- Columna Izquierda: Biografía Oficial -->
      <div class="bio-panel">
        <h3 class="panel-heading">BIOGRAFÍA OFICIAL</h3>
        <div class="bio-text">
          <p>
            Inspirados en la estética y las corrientes musicales de los años 90, <strong>Anttonias</strong> es una banda de rock alternativo, garage rock y post punk revival formada en 2023, y uno de los nombres clave de la “Nueva Escena” del rock chileno.
          </p>
          <p>
            La integran <strong>Antonia Holzapfel</strong> (voz), <strong>Diego Sansana</strong> (guitarra), <strong>Óscar Concha</strong> (guitarra), <strong>Felipe Sanzana</strong> (bajo) y <strong>Agustín Plaza</strong> (batería).
          </p>
        </div>
      </div>

      <!-- Columna Derecha: Contacto Directo & Pack de Prensa -->
      <div class="resources-panel">
        <h3 class="panel-heading">CONTACTO</h3>
        <div class="contact-card">
          <a href="mailto:anttoniasoficial.contacto@gmail.com" class="contact-email">
            anttoniasoficial.contacto@gmail.com
          </a>
          
          <div class="press-cta-wrap">
            <a href="/vault" class="btn-pack-prensa">
              <span>PACK DE PRENSA</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .presskit-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-black);
    border-bottom: 1px solid var(--color-border);
  }

  .presskit-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .presskit-header {
    max-width: 960px;
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 768px) {
    .presskit-header {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 1.5rem;
    }

    .section-title {
      text-align: center;
      letter-spacing: 0.14em;
    }
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }

  .presskit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 900px) {
    .presskit-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }
  }

  .panel-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--color-text-faint);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .bio-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-family: var(--font-mono);
    font-size: clamp(0.84rem, 0.8vw + 0.1rem, 0.94rem);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .bio-text strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .resources-panel {
    display: flex;
    flex-direction: column;
  }

  .contact-card {
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: border-color var(--duration-fast) ease;
  }

  .contact-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  .contact-email {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
    word-break: break-all;
    transition: color var(--duration-fast) ease;
  }

  .contact-email:hover {
    color: var(--accent);
  }

  .contact-desc {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--color-text-faint);
    margin-top: 0.25rem;
  }

  .press-cta-wrap {
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-pack-prensa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 1.75rem;
    background: #ffffff;
    border: 1px solid #ffffff;
    color: #000000;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-pack-prensa:hover {
    background: transparent;
    color: #ffffff;
    border-color: #ffffff;
  }

  .btn-arrow {
    transition: transform var(--duration-fast) ease;
  }

  .btn-pack-prensa:hover .btn-arrow {
    transform: translateX(4px);
  }
</style>
