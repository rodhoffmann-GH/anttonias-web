---
// src/components/Hero.astro
import Logo from './Logo.astro';
---

<section class="hero-section" id="hero" aria-label="Portada de Anttonias">
  <div class="hero-media-wrapper" id="hero-media-wrapper" data-active-media="photo">
    <!-- Fotografía oficial de la sesión en Cementerio General (Claudia Ardid) -->
    <img 
      src="/assets/images/anttonias-cementerio-03.jpg" 
      alt="Anttonias en el Cementerio General de Santiago"
      class="hero-media hero-photo"
      id="hero-photo"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    
    <!-- Video loop del visualizer oficial -->
    <video 
      class="hero-media hero-video"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/assets/video/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      <div class="logo-chroma-wrap" id="hero-chroma-wrap">
        <!-- Capa Roja (Aberración analógica izquierda) -->
        <Logo class="chroma-layer chroma-red" aria-hidden="true" />
        <!-- Capa Cian (Aberración analógica derecha) -->
        <Logo class="chroma-layer chroma-cyan" aria-hidden="true" />
        <!-- Capa Blanca Frontal Principal -->
        <Logo class="chroma-layer chroma-main" id="hero-logo" />
      </div>
      <span class="sr-only">ANTTONIAS</span>
    </h1>

    <div class="hero-manifesto">
      <p class="album-tag">¿QUÉ TAN ROMÁNTICA SERÁ LA MUERTE?</p>
    </div>
  </div>

  <div class="hero-footer-bar">
    <div class="meta-item">
      <!-- Media Switch Temporal (Foto vs Video) para evaluar con Criss -->
      <div class="media-toggle" role="group" aria-label="Cambiar fondo">
        <button type="button" class="toggle-btn active" id="btn-foto" data-target="photo">FOTO</button>
        <span class="toggle-sep">/</span>
        <button type="button" class="toggle-btn" id="btn-video" data-target="video">VIDEO</button>
      </div>
    </div>
    
    <div class="meta-item right">
      <a href="#disco" class="scroll-cue" aria-label="Bajar a la siguiente sección">
        <span class="cue-label">DESCENDER</span>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Media Toggle (Foto vs Video)
  const wrapper = document.getElementById('hero-media-wrapper');
  const btnFoto = document.getElementById('btn-foto');
  const btnVideo = document.getElementById('btn-video');
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  btnFoto?.addEventListener('click', () => {
    wrapper?.setAttribute('data-active-media', 'photo');
    btnFoto.classList.add('active');
    btnVideo?.classList.remove('active');
    video?.pause();
  });

  btnVideo?.addEventListener('click', () => {
    wrapper?.setAttribute('data-active-media', 'video');
    btnVideo.classList.add('active');
    btnFoto?.classList.remove('active');
    video?.play().catch(() => {});
  });

  // Aberración Cromática (RGB Shift) asimétrica, 2D y con desenfoque progresivo al hacer Scroll
  const chromaWrap = document.getElementById('hero-chroma-wrap');
  if (chromaWrap) {
    const updateAberration = () => {
      const scrollY = window.scrollY;
      const progress = Math.min(scrollY / 300, 1.2);
      
      // Desplazamiento X e Y no simétrico (dispersión diagonal analógica)
      const scrollX = progress * 32;       // Hasta 32px en X
      const scrollY_red = progress * 10;   // Rojo se desvía hacia abajo (-10px)
      const scrollY_cyan = progress * 14;  // Cian se desvía hacia arriba (+14px)
      
      // Desenfoque óptico progresivo
      const blurVal = progress * 5.5;      // Hasta 5.5px de desenfoque al abrirse
      
      chromaWrap.style.setProperty('--scroll-x', `${scrollX.toFixed(2)}px`);
      chromaWrap.style.setProperty('--scroll-y-red', `${scrollY_red.toFixed(2)}px`);
      chromaWrap.style.setProperty('--scroll-y-cyan', `${scrollY_cyan.toFixed(2)}px`);
      chromaWrap.style.setProperty('--chroma-blur', `${blurVal.toFixed(2)}px`);
    };

    window.addEventListener('scroll', updateAberration, { passive: true });
    updateAberration();
  }
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 640px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--header-height) + 1.5rem) var(--container-padding) 2rem;
    overflow: hidden;
  }

  .hero-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-base);
  }

  .hero-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: grayscale(100%) contrast(118%) brightness(0.72);
    transition: opacity 0.8s var(--ease-cinematic), transform 12s ease-out;
  }

  .hero-photo {
    transform: scale(1.02);
  }

  .hero-section:hover .hero-photo {
    transform: scale(1.05);
  }

  /* Estado Foto activo */
  .hero-media-wrapper[data-active-media="photo"] .hero-photo {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-media-wrapper[data-active-media="photo"] .hero-video {
    opacity: 0;
    pointer-events: none;
  }

  /* Estado Video activo */
  .hero-media-wrapper[data-active-media="video"] .hero-photo {
    opacity: 0;
    pointer-events: none;
  }
  .hero-media-wrapper[data-active-media="video"] .hero-video {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(8, 8, 8, 0.25) 0%,
      rgba(8, 8, 8, 0.78) 75%,
      rgba(8, 8, 8, 0.96) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: auto 0;
  }

  .hero-title {
    margin: 0;
    padding: 0;
    line-height: 0.88;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Contenedor multicapa de aberración cromática RGB (Grid 1 / 1 superpuesto) */
  .logo-chroma-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(340px, 80vw, 980px);
    height: auto;
    max-height: 280px;
    --chroma-base: 2px;
    --scroll-x: 0px;
    --scroll-y-red: 0px;
    --scroll-y-cyan: 0px;
    --chroma-blur: 0px;
  }

  .logo-chroma-wrap :global(.chroma-layer) {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    max-height: 280px;
    will-change: transform, filter;
  }

  /* Canal Blanco Frontal Principal */
  .logo-chroma-wrap :global(.chroma-main) {
    position: relative;
    z-index: 3;
    color: var(--color-text-primary);
    filter: drop-shadow(0 14px 40px rgba(0, 0, 0, 0.95));
    transition: transform var(--duration-normal) var(--ease-cinematic);
  }

  .logo-chroma-wrap :global(.chroma-main:hover) {
    transform: scale(1.02);
  }

  /* Canal Rojo (Asimétrico: izquierda y arriba, deriva analógica muy lenta y orgánica) */
  .logo-chroma-wrap :global(.chroma-red) {
    z-index: 1;
    color: #ff1438;
    opacity: 0.88;
    mix-blend-mode: screen;
    filter: blur(var(--chroma-blur));
    transform: translate(
      calc((var(--chroma-base) + var(--scroll-x)) * -1),
      calc(var(--scroll-y-red) * -1)
    );
    animation: slowDriftRed 7.8s infinite ease-in-out;
    pointer-events: none;
  }

  /* Canal Azul/Cian (Asimétrico: derecha y abajo, deriva desacoplada de 11.2s) */
  .logo-chroma-wrap :global(.chroma-cyan) {
    z-index: 2;
    color: #00e8ff;
    opacity: 0.88;
    mix-blend-mode: screen;
    filter: blur(var(--chroma-blur));
    transform: translate(
      calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08),
      var(--scroll-y-cyan)
    );
    animation: slowDriftCyan 11.4s infinite ease-in-out;
    pointer-events: none;
  }

  /* Deriva analógica muy muy lenta y etérea para el canal Rojo (ciclo de 7.8s) */
  @keyframes slowDriftRed {
    0%, 100% {
      transform: translate(
        calc((var(--chroma-base) + var(--scroll-x)) * -1),
        calc(var(--scroll-y-red) * -1)
      );
    }
    35% {
      transform: translate(
        calc((var(--chroma-base) + var(--scroll-x) + 0.8px) * -1),
        calc((var(--scroll-y-red) + 0.5px) * -1)
      );
    }
    70% {
      transform: translate(
        calc((var(--chroma-base) + var(--scroll-x) - 0.6px) * -1),
        calc((var(--scroll-y-red) - 0.4px) * -1)
      );
    }
  }

  /* Deriva analógica muy muy lenta y etérea para el canal Cian (ciclo de 11.4s) */
  @keyframes slowDriftCyan {
    0%, 100% {
      transform: translate(
        calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08),
        var(--scroll-y-cyan)
      );
    }
    40% {
      transform: translate(
        calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08 + 0.7px),
        calc(var(--scroll-y-cyan) - 0.6px)
      );
    }
    75% {
      transform: translate(
        calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08 - 0.8px),
        calc(var(--scroll-y-cyan) + 0.4px)
      );
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-manifesto {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .album-tag {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.8vw, 1.5rem);
    letter-spacing: 0.22em;
    color: var(--color-text-primary);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .hero-footer-bar {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--container-max);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
  }

  .media-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
  }

  .toggle-btn {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.15rem 0.3rem;
    transition: color var(--duration-fast) ease;
  }

  .toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .toggle-btn.active {
    color: var(--color-text-primary);
    font-weight: 700;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }

  .toggle-sep {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.65rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-item.right {
    justify-content: flex-end;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .scroll-cue:hover {
    color: var(--color-text-primary);
    transform: translateY(2px);
  }

  .cue-arrow {
    font-size: 0.85rem;
    animation: bobDown 2.2s infinite ease-in-out;
  }

  @keyframes bobDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 768px) {
    .hero-footer-bar {
      gap: 1rem;
    }
  }
</style>
