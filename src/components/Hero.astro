---
// src/components/Hero.astro
import Logo from './Logo.astro';
---

<section class="hero-section" id="hero" aria-label="Portada de Anttonias">
  <div class="hero-media-wrapper" id="hero-media-wrapper" data-active-media="photo">
    <!-- Fotografía oficial de la sesión en Cementerio General (Claudia Ardid) -->
    <img 
      src="/assets/images/anttonias-cementerio-03.jpg" 
      alt="Anttonias en el Cementerio General de Santiago"
      class="hero-media hero-photo"
      id="hero-photo"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    
    <!-- Video loop del visualizer oficial -->
    <video 
      class="hero-media hero-video"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/assets/video/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      <Logo class="hero-logo-svg" id="hero-logo" />
      <span class="sr-only">ANTTONIAS</span>
    </h1>

    <div class="hero-manifesto">
      <p class="album-tag">¿QUÉ TAN ROMÁNTICA SERÁ LA MUERTE?</p>
    </div>
  </div>

  <div class="hero-footer-bar">
    <div class="meta-item">
      <!-- Media Switch Temporal (Foto vs Video) -->
      <div class="media-toggle" role="group" aria-label="Cambiar fondo">
        <button type="button" class="toggle-btn active" id="btn-foto" data-target="photo">FOTO</button>
        <span class="toggle-sep">/</span>
        <button type="button" class="toggle-btn" id="btn-video" data-target="video">VIDEO</button>
      </div>
    </div>
    <div class="meta-item center">
      <a href="#disco" class="scroll-cue" aria-label="Bajar a la siguiente sección">
        <span class="cue-label">DESCENDER</span>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="meta-item right">
      <span class="meta-label">PRODUCCIÓN</span>
      <span class="meta-val">ESTUDIOS DEL SUR // 2026</span>
    </div>
  </div>
</section>

<script>
  // Media Toggle (Foto vs Video)
  const wrapper = document.getElementById('hero-media-wrapper');
  const btnFoto = document.getElementById('btn-foto');
  const btnVideo = document.getElementById('btn-video');
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  btnFoto?.addEventListener('click', () => {
    wrapper?.setAttribute('data-active-media', 'photo');
    btnFoto.classList.add('active');
    btnVideo?.classList.remove('active');
    video?.pause();
  });

  btnVideo?.addEventListener('click', () => {
    wrapper?.setAttribute('data-active-media', 'video');
    btnVideo.classList.add('active');
    btnFoto?.classList.remove('active');
    video?.play().catch(() => {});
  });

  // Aberración Cromática reactiva al Scroll
  const logo = document.getElementById('hero-logo');
  if (logo) {
    const updateAberration = () => {
      const scrollY = window.scrollY;
      // En reposo: 1.5px. Al hacer scroll aumenta gradualmente hasta 12px
      const shift = Math.min(1.5 + (scrollY / 320) * 10.5, 12);
      logo.style.setProperty('--rgb-shift', `${shift.toFixed(2)}px`);
    };

    window.addEventListener('scroll', updateAberration, { passive: true });
    updateAberration();
  }
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 640px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--header-height) + 1.5rem) var(--container-padding) 2rem;
    overflow: hidden;
  }

  .hero-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-base);
  }

  .hero-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: grayscale(100%) contrast(118%) brightness(0.72);
    transition: opacity 0.8s var(--ease-cinematic), transform 12s ease-out;
  }

  .hero-photo {
    transform: scale(1.02);
  }

  .hero-section:hover .hero-photo {
    transform: scale(1.05);
  }

  /* Estado Foto activo */
  .hero-media-wrapper[data-active-media="photo"] .hero-photo {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-media-wrapper[data-active-media="photo"] .hero-video {
    opacity: 0;
    pointer-events: none;
  }

  /* Estado Video activo */
  .hero-media-wrapper[data-active-media="video"] .hero-photo {
    opacity: 0;
    pointer-events: none;
  }
  .hero-media-wrapper[data-active-media="video"] .hero-video {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(8, 8, 8, 0.25) 0%,
      rgba(8, 8, 8, 0.78) 75%,
      rgba(8, 8, 8, 0.96) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: auto 0;
  }

  .hero-title {
    margin: 0;
    padding: 0;
    line-height: 0.88;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Logotipo con Aberración Cromática (RGB Shift) dinámico */
  .hero-logo-svg {
    width: clamp(340px, 80vw, 980px);
    height: auto;
    max-height: 280px;
    color: var(--color-text-primary);
    --rgb-shift: 1.5px;
    filter: 
      drop-shadow(calc(var(--rgb-shift) * -1) 0 0 rgba(230, 45, 60, 0.75))
      drop-shadow(calc(var(--rgb-shift) * 1) 0 0 rgba(60, 160, 240, 0.75))
      drop-shadow(0 14px 35px rgba(0, 0, 0, 0.95));
    transition: transform var(--duration-normal) var(--ease-cinematic);
    will-change: filter;
  }

  .hero-logo-svg:hover {
    transform: scale(1.02);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-manifesto {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .album-tag {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.8vw, 1.5rem);
    letter-spacing: 0.22em;
    color: var(--color-text-primary);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .hero-footer-bar {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--container-max);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
  }

  .media-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
  }

  .toggle-btn {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.15rem 0.3rem;
    transition: color var(--duration-fast) ease;
  }

  .toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .toggle-btn.active {
    color: var(--color-text-primary);
    font-weight: 700;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }

  .toggle-sep {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.65rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-item.center {
    justify-content: center;
  }

  .meta-item.right {
    justify-content: flex-end;
  }

  .meta-label {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .meta-val {
    color: var(--color-text-primary);
    letter-spacing: 0.18em;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .scroll-cue:hover {
    color: var(--color-text-primary);
    transform: translateY(2px);
  }

  .cue-arrow {
    font-size: 0.85rem;
    animation: bobDown 2.2s infinite ease-in-out;
  }

  @keyframes bobDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 768px) {
    .hero-footer-bar {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .meta-item.right {
      display: none;
    }
  }
</style>
