---
// src/components/Hero.astro
import Logo from './Logo.astro';
---

<section class="hero-section" id="hero" aria-label="Portada de Anttonias">
  <div class="hero-media-wrapper" id="hero-media-wrapper" data-active-media="verlos">
    <!-- 1. Fotografía oficial en Cementerio General (Claudia Ardid) -->
    <img 
      src="/assets/images/anttonias-cementerio-03.jpg" 
      alt="Anttonias en el Cementerio General de Santiago"
      class="hero-media media-photo"
      id="media-photo"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    
    <!-- 2. Loop Honestidad (Bosque tipo Blair Witch Project) -->
    <video 
      class="hero-media media-video"
      id="video-honestidad"
      muted
      loop
      playsinline
      preload="none"
    >
      <source src="/assets/video/loop-honestidad.mp4" type="video/mp4" />
    </video>

    <!-- 3. Loop Espíritu (Antonia en estudio/amplis y luz azul) -->
    <video 
      class="hero-media media-video"
      id="video-espiritu"
      muted
      loop
      playsinline
      preload="none"
    >
      <source src="/assets/video/loop-espiritu.mp4" type="video/mp4" />
    </video>

    <!-- 4. Loop Verlos morir (Visualizer semitono / stop-motion) -->
    <video 
      class="hero-media media-video"
      id="video-verlos"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/assets/video/hero-loop.mp4" type="video/mp4" />
    </video>

    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      <div class="logo-chroma-wrap" id="hero-chroma-wrap">
        <!-- Capa Roja (Aberración analógica izquierda) -->
        <Logo class="chroma-layer chroma-red" aria-hidden="true" />
        <!-- Capa Cian (Aberración analógica derecha) -->
        <Logo class="chroma-layer chroma-cyan" aria-hidden="true" />
        <!-- Capa Blanca Frontal Principal -->
        <Logo class="chroma-layer chroma-main" id="hero-logo" />
      </div>
      <span class="sr-only">ANTTONIAS</span>
    </h1>

    <div class="hero-manifesto">
      <p class="album-tag">¿QUÉ TAN ROMÁNTICA SERÁ LA MUERTE?</p>
    </div>
  </div>

  <div class="hero-footer-bar">
    <div class="meta-item">
      <!-- Media Switch Temporal (4 opciones para evaluar con Criss) -->
      <div class="media-toggle" role="group" aria-label="Cambiar fondo">
        <button type="button" class="toggle-btn active" data-target="photo">FOTO</button>
        <span class="toggle-sep">/</span>
        <button type="button" class="toggle-btn" data-target="honestidad">HONESTIDAD (BOSQUE)</button>
        <span class="toggle-sep">/</span>
        <button type="button" class="toggle-btn" data-target="espiritu">ESPÍRITU</button>
        <span class="toggle-sep">/</span>
        <button type="button" class="toggle-btn" data-target="verlos">VERLOS MORIR</button>
      </div>
    </div>
    
    <div class="meta-item right">
      <a href="#disco" class="scroll-cue" aria-label="Bajar a la siguiente sección">
        <span class="cue-label">DESCENDER</span>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Media Toggle (Alternancia entre Foto y 3 Loops de Video)
  const wrapper = document.getElementById('hero-media-wrapper');
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>('.media-toggle .toggle-btn');
  const allVideos = document.querySelectorAll<HTMLVideoElement>('.hero-media-wrapper video');

  // Reproducir loop activo por defecto (Verlos morir)
  const defaultVideo = document.getElementById('video-verlos') as HTMLVideoElement | null;
  if (defaultVideo) {
    defaultVideo.play().catch(() => {});
  }

  toggleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      if (!target || !wrapper) return;

      wrapper.setAttribute('data-active-media', target);
      toggleButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Pausar todos los videos
      allVideos.forEach(v => {
        v.pause();
      });

      // Si es un video, reproducir únicamente el seleccionado
      if (target !== 'photo') {
        const activeVid = document.getElementById(`video-${target}`) as HTMLVideoElement | null;
        if (activeVid) {
          activeVid.play().catch(() => {});
        }
      }
    });
  });

  // Aberración Cromática (RGB Shift) en Desktop con rAF y parada cuando sale del viewport
  const chromaWrap = document.getElementById('hero-chroma-wrap');
  if (chromaWrap && window.innerWidth > 768) {
    let ticking = false;
    const updateAberration = () => {
      const scrollY = window.scrollY;
      if (scrollY > 500) {
        ticking = false;
        return;
      }

      const progress = Math.min(scrollY / 300, 1.2);
      const scrollX = progress * 32;
      const scrollY_red = progress * 10;
      const scrollY_cyan = progress * 14;
      const blurVal = progress * 5.5;
      
      chromaWrap.style.setProperty('--scroll-x', `${scrollX.toFixed(2)}px`);
      chromaWrap.style.setProperty('--scroll-y-red', `${scrollY_red.toFixed(2)}px`);
      chromaWrap.style.setProperty('--scroll-y-cyan', `${scrollY_cyan.toFixed(2)}px`);
      chromaWrap.style.setProperty('--chroma-blur', `${blurVal.toFixed(2)}px`);
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking && window.scrollY < 550) {
        window.requestAnimationFrame(updateAberration);
        ticking = true;
      }
    }, { passive: true });
    updateAberration();
  }
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 640px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--header-height) + 1.5rem) var(--container-padding) 2rem;
    overflow: hidden;
  }

  .hero-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-base);
  }

  .hero-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    opacity: 0;
    pointer-events: none;
    filter: grayscale(100%) contrast(115%) brightness(0.72);
    transition: opacity 0.7s var(--ease-cinematic);
  }

  .media-photo {
    transform: scale(1.02);
    transition: opacity 0.7s var(--ease-cinematic), transform 12s ease-out;
  }

  .hero-section:hover .media-photo {
    transform: scale(1.05);
  }

  /* Estados de activación de fondos */
  .hero-media-wrapper[data-active-media="photo"] #media-photo {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-media-wrapper[data-active-media="honestidad"] #video-honestidad {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-media-wrapper[data-active-media="espiritu"] #video-espiritu {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-media-wrapper[data-active-media="verlos"] #video-verlos {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(8, 8, 8, 0.25) 0%,
      rgba(8, 8, 8, 0.78) 75%,
      rgba(8, 8, 8, 0.96) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: auto 0;
  }

  .hero-title {
    margin: 0;
    padding: 0;
    line-height: 0.88;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Contenedor multicapa de aberración cromática RGB (Grid 1 / 1 superpuesto) */
  .logo-chroma-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(260px, 85vw, 980px);
    max-width: 100%;
    height: auto;
    max-height: 280px;
    --chroma-base: 2px;
    --scroll-x: 0px;
    --scroll-y-red: 0px;
    --scroll-y-cyan: 0px;
    --chroma-blur: 0px;
  }

  .logo-chroma-wrap :global(.chroma-layer) {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    max-height: 280px;
    will-change: transform, filter;
  }

  /* Canal Blanco Frontal Principal */
  .logo-chroma-wrap :global(.chroma-main) {
    position: relative;
    z-index: 3;
    color: var(--color-text-primary);
    filter: drop-shadow(0 14px 40px rgba(0, 0, 0, 0.95));
    transition: transform var(--duration-normal) var(--ease-cinematic);
  }

  .logo-chroma-wrap :global(.chroma-main:hover) {
    transform: scale(1.02);
  }

  /* Canal Rojo (Asimétrico: izquierda y arriba, deriva analógica muy lenta y orgánica) */
  .logo-chroma-wrap :global(.chroma-red) {
    z-index: 1;
    color: #ff1438;
    opacity: 0.88;
    mix-blend-mode: screen;
    filter: blur(var(--chroma-blur));
    transform: translate(
      calc((var(--chroma-base) + var(--scroll-x)) * -1),
      calc(var(--scroll-y-red) * -1)
    );
    animation: slowDriftRed 7.8s infinite ease-in-out;
    pointer-events: none;
  }

  /* Canal Azul/Cian (Asimétrico: derecha y abajo, deriva desacoplada de 11.4s) */
  .logo-chroma-wrap :global(.chroma-cyan) {
    z-index: 2;
    color: #00e8ff;
    opacity: 0.88;
    mix-blend-mode: screen;
    filter: blur(var(--chroma-blur));
    transform: translate(
      calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08),
      var(--scroll-y-cyan)
    );
    animation: slowDriftCyan 11.4s infinite ease-in-out;
    pointer-events: none;
  }

  /* Deriva analógica muy lenta y etérea para el canal Rojo (ciclo de 7.8s) */
  @keyframes slowDriftRed {
    0%, 100% {
      transform: translate(
        calc((var(--chroma-base) + var(--scroll-x)) * -1),
        calc(var(--scroll-y-red) * -1)
      );
    }
    35% {
      transform: translate(
        calc((var(--chroma-base) + var(--scroll-x) + 0.8px) * -1),
        calc((var(--scroll-y-red) + 0.5px) * -1)
      );
    }
    70% {
      transform: translate(
        calc((var(--chroma-base) + var(--scroll-x) - 0.6px) * -1),
        calc((var(--scroll-y-red) - 0.4px) * -1)
      );
    }
  }

  /* Deriva analógica muy lenta y etérea para el canal Cian (ciclo de 11.4s) */
  @keyframes slowDriftCyan {
    0%, 100% {
      transform: translate(
        calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08),
        var(--scroll-y-cyan)
      );
    }
    40% {
      transform: translate(
        calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08 + 0.7px),
        calc(var(--scroll-y-cyan) - 0.6px)
      );
    }
    75% {
      transform: translate(
        calc(var(--chroma-base) * 1.15 + var(--scroll-x) * 1.08 - 0.8px),
        calc(var(--scroll-y-cyan) + 0.4px)
      );
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-manifesto {
    margin-top: clamp(4.5rem, 18vh, 10.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .album-tag {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.8vw, 1.5rem);
    letter-spacing: 0.22em;
    color: var(--color-text-primary);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .hero-footer-bar {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--container-max);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .media-toggle {
    display: none;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    flex-wrap: wrap;
  }

  .toggle-btn {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.15rem 0.35rem;
    transition: color var(--duration-fast) ease;
  }

  .toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .toggle-btn.active {
    color: var(--color-text-primary);
    font-weight: 700;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }

  .toggle-sep {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.65rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-item.right {
    justify-content: flex-end;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .scroll-cue:hover {
    color: var(--color-text-primary);
    transform: translateY(2px);
  }

  .cue-arrow {
    font-size: 0.85rem;
    animation: bobDown 2.2s infinite ease-in-out;
  }

  @keyframes bobDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 768px) {
    .hero-footer-bar {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .media-toggle {
      justify-content: center;
    }
  }
</style>
