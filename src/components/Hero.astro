---
// src/components/Hero.astro
import Logo from './Logo.astro';
---

<section class="hero-section" id="hero" aria-label="Portada de Anttonias">
  <div class="hero-media-wrapper">
    <!-- Fotografía oficial de la sesión en Cementerio General (Claudia Ardid) -->
    <img 
      src="/assets/images/anttonias-cementerio-03.jpg" 
      alt="Anttonias en el Cementerio General de Santiago"
      class="hero-media"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <div class="hero-eyebrow">
      <span class="eyebrow-line" aria-hidden="true"></span>
      <span class="eyebrow-text">SANTIAGO // LOTUS RECORDS</span>
      <span class="eyebrow-line" aria-hidden="true"></span>
    </div>

    <h1 class="hero-title">
      <Logo class="hero-logo-svg" />
      <span class="sr-only">ANTTONIAS</span>
    </h1>

    <div class="hero-manifesto">
      <p class="album-tag">¿QUÉ TAN ROMÁNTICA SERÁ LA MUERTE?</p>
      <p class="album-subtext">EL SEGUNDO ÁLBUM DE ESTUDIO // YA DISPONIBLE</p>
    </div>

    <div class="hero-actions">
      <a href="#disco" class="btn-primary">
        <span class="btn-text">ESCUCHAR DISCO</span>
        <span class="btn-icon" aria-hidden="true">↓</span>
      </a>
      <a href="#gira" class="btn-secondary">
        <span class="btn-text">FECHAS EN VIVO</span>
      </a>
    </div>
  </div>

  <div class="hero-footer-bar">
    <div class="meta-item">
      <span class="meta-label">DISCO</span>
      <span class="meta-val">11 CANCIONES // 5 ACTOS</span>
    </div>
    <div class="meta-item center">
      <a href="#disco" class="scroll-cue" aria-label="Bajar a la siguiente sección">
        <span class="cue-label">DESCENDER</span>
        <span class="cue-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="meta-item right">
      <span class="meta-label">PRODUCCIÓN</span>
      <span class="meta-val">ESTUDIOS DEL SUR // 2026</span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 640px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: clamp(5rem, 10vh, 7rem) var(--container-padding) 2rem;
    overflow: hidden;
  }

  .hero-media-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-base);
  }

  .hero-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: grayscale(100%) contrast(118%) brightness(0.72);
    transform: scale(1.02);
    transition: transform 12s ease-out;
  }

  .hero-section:hover .hero-media {
    transform: scale(1.06);
  }

  .hero-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(8, 8, 8, 0.2) 0%,
      rgba(8, 8, 8, 0.75) 75%,
      rgba(8, 8, 8, 0.95) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: auto 0;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .eyebrow-line {
    width: clamp(24px, 4vw, 60px);
    height: 1px;
    background-color: var(--color-border);
  }

  .eyebrow-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.35em;
    color: var(--color-text-muted);
  }

  .hero-title {
    margin: 0;
    padding: 0;
    line-height: 0.88;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hero-logo-svg {
    width: clamp(280px, 60vw, 720px);
    height: auto;
    max-height: 220px;
    color: var(--color-text-primary);
    filter: drop-shadow(0 6px 35px rgba(0, 0, 0, 0.95))
            drop-shadow(0 0 20px rgba(82, 134, 184, 0.2));
    transition: transform var(--duration-normal) var(--ease-cinematic);
  }

  .hero-logo-svg:hover {
    transform: scale(1.02);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-manifesto {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .album-tag {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.6rem);
    letter-spacing: 0.15em;
    color: var(--color-text-primary);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .album-subtext {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--color-text-muted);
  }

  .hero-actions {
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    background-color: var(--color-text-primary);
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    border: 1px solid var(--color-text-primary);
    transition: background-color var(--duration-fast) ease,
                color var(--duration-fast) ease,
                transform var(--duration-fast) var(--ease-cinematic);
  }

  .btn-primary:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    background: rgba(8, 8, 8, 0.6);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    transition: border-color var(--duration-fast) ease,
                background-color var(--duration-fast) ease,
                transform var(--duration-fast) var(--ease-cinematic);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    background: rgba(8, 8, 8, 0.85);
    transform: translateY(-2px);
  }

  .hero-footer-bar {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--container-max);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: flex-end;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-item.center {
    align-items: center;
  }

  .meta-item.right {
    align-items: flex-end;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    color: var(--color-text-faint);
  }

  .meta-val {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .scroll-cue:hover {
    color: var(--accent);
    transform: translateY(3px);
  }

  .cue-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
  }

  .cue-arrow {
    font-size: 0.85rem;
    animation: bounce 2s infinite ease-in-out;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 768px) {
    .hero-footer-bar {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
    }
    .meta-item,
    .meta-item.right {
      display: none;
    }
    .meta-item.center {
      display: flex;
    }
  }
</style>
