---
// src/components/Gallery.astro

const photos = [
  {
    src: "/assets/images/anttonias-cementerio-01.jpg",
    alt: "Anttonias en el Cementerio General de Santiago - Retrato Coral",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "monument"
  },
  {
    src: "/assets/images/anttonias-cementerio-03.jpg",
    alt: "Antonia Holzapfel y la atmósfera fúnebre",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "portrait"
  },
  {
    src: "/assets/images/anttonias-cementerio-04.jpg",
    alt: "Banda entre sepulcros y cruces de hierro",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "landscape"
  },
  {
    src: "/assets/images/anttonias-cementerio-103.jpg",
    alt: "Detalle fúnebre y contraste en blanco y negro",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "square"
  },
  {
    src: "/assets/images/anttonias-debut-rod-659.jpg",
    alt: "Anttonias en vivo - Era debut",
    credits: "FOTOGRAFÍA: ROD HOFFMANN",
    aspect: "portrait"
  }
];
---

<section class="gallery-section" id="galeria" aria-label="Galería fotográfica oficial">
  <div class="gallery-container">
    <div class="gallery-header">
      <h2 class="section-title">REGISTRO FOTOGRÁFICO</h2>
    </div>

    <div class="gallery-layout">
      {photos.map((p, idx) => (
        <figure class={`photo-card item-${idx} aspect-${p.aspect}`}>
          <div class="photo-frame">
            <img 
              src={p.src} 
              alt={p.alt}
              class="gallery-img"
              loading="lazy"
            />
          </div>
          <figcaption class="photo-caption">
            <span class="caption-credits">{p.credits}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .gallery-header {
    max-width: 960px;
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }

  .gallery-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .gallery-layout {
      grid-template-columns: repeat(12, 1fr);
      gap: 2rem;
    }

    .item-0 {
      grid-column: 1 / 8;
    }

    .item-1 {
      grid-column: 8 / 13;
    }

    .item-2 {
      grid-column: 1 / 7;
    }

    .item-3 {
      grid-column: 7 / 10;
    }

    .item-4 {
      grid-column: 10 / 13;
    }
  }

  .photo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    transition: border-color var(--duration-fast) ease;
  }

  .photo-card:hover {
    border-color: var(--accent);
  }

  .photo-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-black);
  }

  .item-0 .photo-frame {
    aspect-ratio: 16 / 10;
  }

  .item-1 .photo-frame {
    aspect-ratio: 4 / 5;
  }

  .item-2 .photo-frame {
    aspect-ratio: 16 / 9;
  }

  .item-3 .photo-frame,
  .item-4 .photo-frame {
    aspect-ratio: 1 / 1;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(122%);
    transition: transform var(--duration-slow) var(--ease-cinematic);
  }

  .photo-card:hover .gallery-img {
    transform: scale(1.03);
  }

  .photo-caption {
    display: flex;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    padding: 0.4rem 0.25rem 0;
  }

  .caption-credits {
    color: var(--color-text-faint);
  }
</style>
