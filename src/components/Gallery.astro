<section class="gallery-section" id="galeria" aria-label="Galería fotográfica oficial">
  <div class="gallery-container">
    <div class="gallery-header">
      <h2 class="section-title">FOTOGRAFÍAS</h2>
    </div>

    <!-- Masonry de 3 Columnas -->
    <div class="gallery-layout">
      {photos.map((p, idx) => (
        <figure class="photo-card">
          <button 
            type="button" 
            class="photo-frame photo-trigger"
            data-index={idx}
            aria-label={`Ampliar fotografía: ${p.alt}`}
          >
            <picture>
              <source srcset={p.gridAvif} type="image/avif" />
              <source srcset={p.gridWebp} type="image/webp" />
              <img 
                src={p.gridJpg} 
                alt={p.alt}
                class="gallery-img"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <span class="zoom-indicator" aria-hidden="true">+</span>
          </button>
          <figcaption class="photo-caption">
            <span class="caption-credits">{p.credits}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <!-- Lightbox Minimalista (Viewport Constrained) -->
  <dialog class="gallery-lightbox" id="gallery-lightbox" aria-label="Visualizador de fotografía en alta resolución">
    <div class="lightbox-stage">
      <button type="button" class="lightbox-btn btn-close" id="lb-close" aria-label="Cerrar visor (Esc)">
        <span aria-hidden="true">&times;</span>
      </button>

      <button type="button" class="lightbox-btn btn-nav btn-prev" id="lb-prev" aria-label="Fotografía anterior">
        <span aria-hidden="true">&#8592;</span>
      </button>

      <div class="lightbox-media-wrap">
        <div class="lightbox-img-frame">
          <picture id="lb-picture">
            <source id="lb-source-avif" srcset="" type="image/avif" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1600px" />
            <source id="lb-source-webp" srcset="" type="image/webp" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1600px" />
            <img src="" alt="" id="lb-img" class="lightbox-image" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1600px" />
          </picture>
        </div>
        <div class="lightbox-meta">
          <span class="lb-counter" id="lb-counter"></span>
          <span class="lb-credits" id="lb-credits"></span>
        </div>
      </div>

      <button type="button" class="lightbox-btn btn-nav btn-next" id="lb-next" aria-label="Fotografía siguiente">
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>
  </dialog>
</section>

<style>
  .gallery-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .gallery-header {
    max-width: 960px;
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 768px) {
    .gallery-header {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 1.5rem;
    }

    .section-title {
      text-align: center;
      letter-spacing: 0.14em;
    }
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }

  /* ==========================================================================
     MASONRY RETINA (3 Columnas Desktop | 2 Tablet | 1 Móvil)
     ========================================================================== */
  .gallery-layout {
    columns: 3;
    column-gap: 1.5rem;
  }

  @media (max-width: 992px) {
    .gallery-layout {
      columns: 2;
      column-gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .gallery-layout {
      columns: 2;
      column-gap: 0.75rem;
    }

    .photo-card {
      margin-bottom: 0.75rem;
      padding: 0.4rem;
    }

    .photo-caption {
      font-size: 0.58rem;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.15rem 0;
    }
  }

  .photo-card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    padding: 0.6rem;
    transition: border-color var(--duration-fast) ease, transform var(--duration-fast) var(--ease-cinematic);
  }

  .photo-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .photo-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-black);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: block;
    text-align: left;
  }

  .photo-frame picture {
    display: block;
    width: 100%;
  }

  .zoom-indicator {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 8, 8, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-text-primary);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
    backdrop-filter: blur(4px);
  }

  .photo-frame:hover .zoom-indicator,
  .photo-frame:focus-visible .zoom-indicator {
    opacity: 1;
    transform: scale(1);
  }

  .gallery-img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(100%) contrast(120%);
    transition: transform var(--duration-slow) var(--ease-cinematic);
  }

  .photo-card:hover .gallery-img {
    transform: scale(1.025);
  }

  .photo-caption {
    display: flex;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    padding: 0.35rem 0.25rem 0;
  }

  .caption-credits {
    color: var(--color-text-faint);
  }

  /* ==========================================================================
     LIGHTBOX MINIMALISTA (Viewport Constrained / Zero Overflow)
     ========================================================================== */
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    z-index: var(--z-overlay);
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .gallery-lightbox[open] {
    display: flex;
  }

  .gallery-lightbox::backdrop {
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .lightbox-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vh, 2rem) clamp(1rem, 4vw, 3rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .lightbox-media-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-width: min(88vw, 1600px);
    max-height: calc(100vh - 4.5rem);
    gap: 0.75rem;
  }

  .lightbox-img-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    max-height: calc(100vh - 7.5rem);
    overflow: hidden;
  }

  .lightbox-img-frame picture {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  .lightbox-img-frame .lightbox-image {
    max-width: min(86vw, 1600px);
    max-height: calc(100vh - 8rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.95);
    filter: grayscale(100%) contrast(115%);
    background: #000;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    touch-action: pan-y;
  }

  .lightbox-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: min(86vw, 1600px);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    padding: 0 0.25rem;
    flex-shrink: 0;
  }

  .lb-counter {
    color: var(--color-text-primary);
  }

  .lb-credits {
    color: var(--color-text-faint);
  }

  .lightbox-btn {
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-btn:hover {
    color: var(--accent-hover);
  }

  .btn-close {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-size: 2.2rem;
    font-family: var(--font-mono);
    width: 44px;
    height: 44px;
    line-height: 1;
    z-index: 10;
  }

  .btn-close:hover {
    transform: scale(1.1);
  }

  .btn-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    font-family: var(--font-mono);
    width: 50px;
    height: 50px;
    z-index: 10;
    opacity: 0.55;
    transition: opacity var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .btn-nav:hover {
    opacity: 1;
  }

  .btn-prev {
    left: 1.5rem;
  }

  .btn-next {
    right: 1.5rem;
  }

  @media (max-width: 768px) {
    .btn-nav {
      font-size: 1.5rem;
      width: 40px;
      height: 40px;
    }
    .btn-prev { left: 0.5rem; }
    .btn-next { right: 0.5rem; }
    .btn-close { top: 1rem; right: 1rem; }
    .lightbox-stage { padding: 1rem; }
    .lightbox-img-frame .lightbox-image {
      max-width: 92vw;
      max-height: calc(100vh - 9rem);
    }
  }
</style>

<script>
  const photosData = [
    {
