---
// src/components/Gallery.astro

const photos = [
  {
    src: "/assets/images/anttonias-cementerio-03.jpg",
    alt: "Anttonias en el Cementerio General de Recoleta",
    caption: "SESIÓN OFICIAL // CEMENTERIO GENERAL DE RECOLETA",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "landscape"
  },
  {
    src: "/assets/images/anttonias-debut-rod-659.jpg",
    alt: "Anttonias en escena y retrato de debut",
    caption: "RETRATO EN VIVO // ARCHIVO DEBUT",
    credits: "FOTOGRAFÍA: ROD HOFFMANN",
    aspect: "portrait"
  },
  {
    src: "/assets/images/anttonias-cementerio-03.jpg",
    alt: "Detalle fúnebre y atmósfera de ¿Qué tan romántica será la muerte?",
    caption: "DETALLE ATMOSFÉRICO // LOS CINCO ACTOS",
    credits: "ARTE Y DIRECCIÓN: CLAUDIA ARDID",
    aspect: "square"
  }
];
---

<section class="gallery-section" id="galeria" aria-label="Galería fotográfica oficial">
  <div class="gallery-container">
    <div class="gallery-header">
      <span class="section-tag">// ARCHIVO VISUAL // BLANCO Y NEGRO</span>
      <h2 class="section-title">REGISTRO FOTOGRÁFICO</h2>
      <p class="gallery-lead">
        La estética cruda del romanticismo fúnebre: registro en película 35mm en el Cementerio General de Santiago y archivos en vivo de su trayectoria.
      </p>
    </div>

    <div class="gallery-layout">
      {photos.map((p, idx) => (
        <figure class={`photo-card item-${idx} aspect-${p.aspect}`}>
          <div class="photo-frame">
            <img 
              src={p.src} 
              alt={p.alt}
              class="gallery-img"
              loading="lazy"
            />
          </div>
          <figcaption class="photo-caption">
            <span class="caption-title">{p.caption}</span>
            <span class="caption-credits">{p.credits}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .gallery-header {
    max-width: 760px;
    margin-bottom: var(--space-lg);
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .gallery-lead {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .gallery-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .gallery-layout {
      grid-template-columns: 1.3fr 1fr;
      grid-template-rows: auto auto;
      gap: 2.5rem;
    }

    .item-0 {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }

    .item-1 {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
    }

    .item-2 {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
    }
  }

  .photo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    transition: border-color var(--duration-fast) ease;
  }

  .photo-card:hover {
    border-color: var(--accent);
  }

  .photo-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-black);
  }

  .item-0 .photo-frame {
    aspect-ratio: 16 / 11;
  }

  .item-1 .photo-frame {
    aspect-ratio: 4 / 3;
  }

  .item-2 .photo-frame {
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 860px) {
    .item-0 .photo-frame {
      height: 100%;
      min-height: 540px;
    }
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    transition: transform var(--duration-slow) var(--ease-cinematic);
  }

  .photo-card:hover .gallery-img {
    transform: scale(1.03);
  }

  .photo-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    padding: 0.25rem 0.25rem 0;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .caption-title {
    color: var(--color-text-primary);
  }

  .caption-credits {
    color: var(--color-text-faint);
  }
</style>
