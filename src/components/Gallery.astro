    },
    {
      id: "photo-05",
      alt: "Retrato de banda frente al mausoleo",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-05-2560.avif",
      webp: "/assets/images/gallery/photo-05-2560.webp",
      jpg: "/assets/images/gallery/photo-05-2560.jpg"
    },
    {
      id: "photo-06",
      alt: "Guitarras y arquitectura del Cementerio General",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-06-2560.avif",
      webp: "/assets/images/gallery/photo-06-2560.webp",
      jpg: "/assets/images/gallery/photo-06-2560.jpg"
    },
    {
      id: "photo-07",
      alt: "Perspectiva diagonal entre tumbas",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-07-2560.avif",
      webp: "/assets/images/gallery/photo-07-2560.webp",
      jpg: "/assets/images/gallery/photo-07-2560.jpg"
    },
    {
      id: "photo-08",
      alt: "Atmósfera de niebla y luz de cementerio",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-08-2560.avif",
      webp: "/assets/images/gallery/photo-08-2560.webp",
      jpg: "/assets/images/gallery/photo-08-2560.jpg"
    },
    {
      id: "photo-09",
      alt: "Retrato coral de Anttonias en el pasaje de criptas",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-09-2560.avif",
      webp: "/assets/images/gallery/photo-09-2560.webp",
      jpg: "/assets/images/gallery/photo-09-2560.jpg"
    },
    {
      id: "photo-10",
      alt: "Composición fúnebre en blanco y negro",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-10-2560.avif",
      webp: "/assets/images/gallery/photo-10-2560.webp",
      jpg: "/assets/images/gallery/photo-10-2560.jpg"
    },
    {
      id: "photo-11",
      alt: "Anttonias en vivo - Era debut",
      credits: "FOTOGRAFÍA: ROD HOFFMANN",
      avif: "/assets/images/gallery/photo-11-2560.avif",
      webp: "/assets/images/gallery/photo-11-2560.webp",
      jpg: "/assets/images/gallery/photo-11-2560.jpg"
    }
  ];

  const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbSourceAvif = document.getElementById('lb-source-avif') as HTMLSourceElement | null;
  const lbSourceWebp = document.getElementById('lb-source-webp') as HTMLSourceElement | null;
  const lbCredits = document.getElementById('lb-credits');
  const lbCounter = document.getElementById('lb-counter');
  const btnClose = document.getElementById('lb-close');
  const btnPrev = document.getElementById('lb-prev');
  const btnNext = document.getElementById('lb-next');
  const triggers = document.querySelectorAll<HTMLButtonElement>('.photo-trigger');

  let currentIndex = 0;

  function getSrcset(id: string, ext: string) {
    return `/assets/images/gallery/${id}-800.${ext} 800w, /assets/images/gallery/${id}-1600.${ext} 1600w, /assets/images/gallery/${id}-2560.${ext} 2560w`;
  }

  function preloadNeighbor(idx: number) {
    const p = photosData[idx];
    if (!p) return;
    const size = window.innerWidth <= 768 ? '800' : (window.innerWidth <= 1200 ? '1600' : '2560');
    const img = new Image();
    img.src = `/assets/images/gallery/${p.id}-${size}.webp`;
  }

  function showPhoto(idx: number) {
    if (idx < 0) idx = photosData.length - 1;
    if (idx >= photosData.length) idx = 0;
    currentIndex = idx;

    const p = photosData[currentIndex];
    if (lbSourceAvif) lbSourceAvif.srcset = getSrcset(p.id, 'avif');
    if (lbSourceWebp) lbSourceWebp.srcset = getSrcset(p.id, 'webp');
    if (lbImg) {
      const fallbackSize = window.innerWidth <= 768 ? '800' : '1600';
      lbImg.src = `/assets/images/gallery/${p.id}-${fallbackSize}.jpg`;
      lbImg.srcset = getSrcset(p.id, 'jpg');
      lbImg.alt = p.alt;
    }
    if (lbCredits) lbCredits.textContent = p.credits;
    if (lbCounter) lbCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(photosData.length).padStart(2, '0')}`;

    // Preload inmediato de fotos adyacentes para que el swipe sea a 0ms de latencia
    const nextIdx = (currentIndex + 1) % photosData.length;
    const prevIdx = (currentIndex - 1 + photosData.length) % photosData.length;
    preloadNeighbor(nextIdx);
    preloadNeighbor(prevIdx);
  }

  function openLightbox(idx: number) {
    showPhoto(idx);
    lightbox?.showModal();
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.close();
    document.body.style.overflow = '';
  }

  triggers.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-index') || '0');
      openLightbox(idx);
    });
  });

  btnClose?.addEventListener('click', closeLightbox);
  btnPrev?.addEventListener('click', () => showPhoto(currentIndex - 1));
  btnNext?.addEventListener('click', () => showPhoto(currentIndex + 1));

  // Clic/Tap fuera de la foto cierra inmediatamente el lightbox
  lightbox?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    // Si el toque fue dentro de la imagen o en un botón de control, no cerrar
    if (target.id === 'lb-img' || target.closest('.lightbox-btn') || target.closest('.lightbox-meta')) {
      return;
    }
    closeLightbox();
  });

  // Soporte de Gesto Swipe en Móviles (← Siguiente / Anterior →)
  let touchStartX = 0;
  let touchStartY = 0;
  let touchEndX = 0;
  let touchEndY = 0;
  let isSwiping = false;

  lightbox?.addEventListener('touchstart', (e: TouchEvent) => {
    if (e.touches.length === 1) {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      touchEndX = touchStartX;
      touchEndY = touchStartY;
      isSwiping = true;
    }
  }, { passive: true });

  lightbox?.addEventListener('touchmove', (e: TouchEvent) => {
    if (isSwiping && e.touches.length === 1) {
      touchEndX = e.touches[0].clientX;
      touchEndY = e.touches[0].clientY;
    }
  }, { passive: true });

  lightbox?.addEventListener('touchend', () => {
    if (!isSwiping) return;
    isSwiping = false;
    const diffX = touchEndX - touchStartX;
    const diffY = touchEndY - touchStartY;
    const threshold = 40; // Mínimo de 40px para considerar swipe intencional

    if (Math.abs(diffX) > threshold && Math.abs(diffX) > Math.abs(diffY) * 1.1) {
      if (diffX < 0) {
        // Swipe hacia la izquierda: siguiente foto
        showPhoto(currentIndex + 1);
      } else {
        // Swipe hacia la derecha: foto anterior
        showPhoto(currentIndex - 1);
      }
    }
  });

  lightbox?.addEventListener('cancel', () => {
    document.body.style.overflow = '';
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
</script>
