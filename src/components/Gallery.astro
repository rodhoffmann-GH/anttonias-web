---
// src/components/Gallery.astro

const photos = [
  {
    src: "/assets/images/anttonias-cementerio-01.jpg",
    alt: "Anttonias en el Cementerio General de Santiago - Retrato Coral",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "monument"
  },
  {
    src: "/assets/images/anttonias-cementerio-03.jpg",
    alt: "Antonia Holzapfel y la atmósfera fúnebre",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "portrait"
  },
  {
    src: "/assets/images/anttonias-cementerio-04.jpg",
    alt: "Banda entre sepulcros y cruces de hierro",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "landscape"
  },
  {
    src: "/assets/images/anttonias-cementerio-103.jpg",
    alt: "Detalle fúnebre y contraste en blanco y negro",
    credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
    aspect: "square"
  },
  {
    src: "/assets/images/anttonias-debut-rod-659.jpg",
    alt: "Anttonias en vivo - Era debut",
    credits: "FOTOGRAFÍA: ROD HOFFMANN",
    aspect: "portrait"
  }
];
---

<section class="gallery-section" id="galeria" aria-label="Galería fotográfica oficial">
  <div class="gallery-container">
    <div class="gallery-header">
      <h2 class="section-title">FOTOGRAFÍAS</h2>
    </div>

    <div class="gallery-layout">
      {photos.map((p, idx) => (
        <figure class={`photo-card item-${idx} aspect-${p.aspect}`}>
          <button 
            type="button" 
            class="photo-frame photo-trigger"
            data-index={idx}
            aria-label={`Ampliar fotografía: ${p.alt}`}
          >
            <img 
              src={p.src} 
              alt={p.alt}
              class="gallery-img"
              loading="lazy"
            />
            <span class="zoom-indicator" aria-hidden="true">+</span>
          </button>
          <figcaption class="photo-caption">
            <span class="caption-credits">{p.credits}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <!-- Lightbox Minimalista -->
  <dialog class="gallery-lightbox" id="gallery-lightbox" aria-label="Visualizador de fotografía">
    <div class="lightbox-stage">
      <button type="button" class="lightbox-btn btn-close" id="lb-close" aria-label="Cerrar visor (Esc)">
        <span aria-hidden="true">&times;</span>
      </button>

      <button type="button" class="lightbox-btn btn-nav btn-prev" id="lb-prev" aria-label="Fotografía anterior">
        <span aria-hidden="true">&#8592;</span>
      </button>

      <div class="lightbox-media-wrap">
        <img src="" alt="" id="lb-img" class="lightbox-image" />
        <div class="lightbox-meta">
          <span class="lb-counter" id="lb-counter"></span>
          <span class="lb-credits" id="lb-credits"></span>
        </div>
      </div>

      <button type="button" class="lightbox-btn btn-nav btn-next" id="lb-next" aria-label="Fotografía siguiente">
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>
  </dialog>
</section>

<style>
  .gallery-section {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-xl) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .gallery-header {
    max-width: 960px;
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--font-size-title);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }

  .gallery-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .gallery-layout {
      grid-template-columns: repeat(12, 1fr);
      gap: 2rem;
    }

    .item-0 {
      grid-column: 1 / 8;
    }

    .item-1 {
      grid-column: 8 / 13;
    }

    .item-2 {
      grid-column: 1 / 7;
    }

    .item-3 {
      grid-column: 7 / 10;
    }

    .item-4 {
      grid-column: 10 / 13;
    }
  }

  .photo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    transition: border-color var(--duration-fast) ease;
  }

  .photo-card:hover {
    border-color: var(--accent);
  }

  .photo-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-black);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: block;
    text-align: left;
  }

  .zoom-indicator {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 8, 8, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-text-primary);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
    backdrop-filter: blur(4px);
  }

  .photo-frame:hover .zoom-indicator,
  .photo-frame:focus-visible .zoom-indicator {
    opacity: 1;
    transform: scale(1);
  }

  .item-0 .photo-frame {
    aspect-ratio: 16 / 10;
  }

  .item-1 .photo-frame {
    aspect-ratio: 4 / 5;
  }

  .item-2 .photo-frame {
    aspect-ratio: 16 / 9;
  }

  .item-3 .photo-frame,
  .item-4 .photo-frame {
    aspect-ratio: 1 / 1;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(122%);
    transition: transform var(--duration-slow) var(--ease-cinematic);
  }

  .photo-card:hover .gallery-img {
    transform: scale(1.03);
  }

  .photo-caption {
    display: flex;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    padding: 0.4rem 0.25rem 0;
  }

  .caption-credits {
    color: var(--color-text-faint);
  }

  /* Lightbox Minimalista */
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    z-index: var(--z-overlay);
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .gallery-lightbox[open] {
    display: flex;
  }

  .gallery-lightbox::backdrop {
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .lightbox-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox-media-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 90vw;
  }

  .lightbox-image {
    max-height: 78vh;
    max-width: 86vw;
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.95);
    filter: grayscale(100%) contrast(115%);
    background: #000;
  }

  .lightbox-meta {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 86vw;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    padding: 0 0.5rem;
  }

  .lb-counter {
    color: var(--color-text-primary);
  }

  .lb-credits {
    color: var(--color-text-faint);
  }

  .lightbox-btn {
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-btn:hover {
    color: var(--accent-hover);
  }

  .btn-close {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-size: 2.2rem;
    font-family: var(--font-mono);
    width: 44px;
    height: 44px;
    line-height: 1;
    z-index: 10;
  }

  .btn-close:hover {
    transform: scale(1.1);
  }

  .btn-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    font-family: var(--font-mono);
    width: 50px;
    height: 50px;
    z-index: 10;
    opacity: 0.55;
    transition: opacity var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .btn-nav:hover {
    opacity: 1;
  }

  .btn-prev {
    left: 1.5rem;
  }

  .btn-next {
    right: 1.5rem;
  }

  @media (max-width: 768px) {
    .btn-nav {
      font-size: 1.5rem;
      width: 40px;
      height: 40px;
    }
    .btn-prev { left: 0.5rem; }
    .btn-next { right: 0.5rem; }
    .btn-close { top: 1rem; right: 1rem; }
    .lightbox-stage { padding: 1rem; }
  }
</style>

<script>
  const photosData = [
    { src: "/assets/images/anttonias-cementerio-01.jpg", alt: "Anttonias en el Cementerio General de Santiago - Retrato Coral", credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)" },
    { src: "/assets/images/anttonias-cementerio-03.jpg", alt: "Antonia Holzapfel y la atmósfera fúnebre", credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)" },
    { src: "/assets/images/anttonias-cementerio-04.jpg", alt: "Banda entre sepulcros y cruces de hierro", credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)" },
    { src: "/assets/images/anttonias-cementerio-103.jpg", alt: "Detalle fúnebre y contraste en blanco y negro", credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)" },
    { src: "/assets/images/anttonias-debut-rod-659.jpg", alt: "Anttonias en vivo - Era debut", credits: "FOTOGRAFÍA: ROD HOFFMANN" }
  ];

  const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbCredits = document.getElementById('lb-credits');
  const lbCounter = document.getElementById('lb-counter');
  const btnClose = document.getElementById('lb-close');
  const btnPrev = document.getElementById('lb-prev');
  const btnNext = document.getElementById('lb-next');
  const triggers = document.querySelectorAll<HTMLButtonElement>('.photo-trigger');

  let currentIndex = 0;

  function showPhoto(idx: number) {
    if (idx < 0) idx = photosData.length - 1;
    if (idx >= photosData.length) idx = 0;
    currentIndex = idx;

    const p = photosData[currentIndex];
    if (lbImg) {
      lbImg.src = p.src;
      lbImg.alt = p.alt;
    }
    if (lbCredits) lbCredits.textContent = p.credits;
    if (lbCounter) lbCounter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(photosData.length).padStart(2, '0')}`;
  }

  function openLightbox(idx: number) {
    showPhoto(idx);
    lightbox?.showModal();
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.close();
    document.body.style.overflow = '';
  }

  triggers.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-index') || '0');
      openLightbox(idx);
    });
  });

  btnClose?.addEventListener('click', closeLightbox);
  btnPrev?.addEventListener('click', () => showPhoto(currentIndex - 1));
  btnNext?.addEventListener('click', () => showPhoto(currentIndex + 1));

  lightbox?.addEventListener('click', (e) => {
    // Si se hace clic fuera del contenido principal (en el backdrop)
    const stage = document.querySelector('.lightbox-media-wrap');
    if (stage && !stage.contains(e.target as Node) && !(e.target as HTMLElement).closest('.lightbox-btn')) {
      closeLightbox();
    }
  });

  lightbox?.addEventListener('cancel', () => {
    document.body.style.overflow = '';
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
</script>
