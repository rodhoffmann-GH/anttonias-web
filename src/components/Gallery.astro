    },
    {
      id: "photo-04",
      alt: "Detalle de lápidas y perspectiva fúnebre",
      credits: "FOTOGRAFÍA: CLAUDIA ARDID (2026)",
      avif: "/assets/images/gallery/photo-04-2560.avif",
