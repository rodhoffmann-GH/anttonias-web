---
// src/components/Nav.astro
import Logo from './Logo.astro';
---

<header class="site-header" id="site-header">
  <div class="nav-container">
    <a href="#hero" class="nav-logo" aria-label="Anttonias - Inicio">
      <Logo class="nav-logo-svg" />
      <span class="sr-only">ANTTONIAS</span>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      <a href="#disco" class="nav-link">QTRSLM</a>
      <a href="#gira" class="nav-link">FECHAS</a>
      <a href="#videos" class="nav-link">VIDEOS</a>
      <a href="#catalogo" class="nav-link">CATÁLOGO</a>
      <a href="#prensa" class="nav-link">PRENSA / EPK</a>
    </nav>

    <div class="nav-right" aria-hidden="true"></div>

    <!-- Toggle Móvil Accesible -->
    <button class="mobile-toggle" id="mobile-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú de navegación">
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>
  </div>

  <!-- Drawer Móvil -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav-links">
      <!-- Cruz fúnebre estilizada (enlace a inicio) -->
      <a href="#hero" class="mobile-nav-link link-home-cross" aria-label="Anttonias - Ir al inicio">
        <svg class="tomb-cross-icon" viewBox="0 0 24 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="2" x2="12" y2="34" />
          <line x1="4" y1="11" x2="20" y2="11" />
        </svg>
        <span class="sr-only">Inicio</span>
      </a>
      <a href="#disco" class="mobile-nav-link">QTRSLM</a>
      <a href="#gira" class="mobile-nav-link">FECHAS</a>
      <a href="#videos" class="mobile-nav-link">VIDEOS</a>
      <a href="#catalogo" class="mobile-nav-link">CATÁLOGO</a>
      <a href="#prensa" class="mobile-nav-link">PRENSA / EPK</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: var(--z-header);
    padding: 1.25rem 0;
    background: linear-gradient(to bottom, rgba(8, 8, 8, 0.35) 0%, rgba(8, 8, 8, 0) 100%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    transition: background var(--duration-normal) var(--ease-cinematic),
                backdrop-filter var(--duration-normal) var(--ease-cinematic),
                border-color var(--duration-normal) var(--ease-cinematic),
                padding var(--duration-normal) var(--ease-cinematic);
  }

  .nav-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 860px) {
    .nav-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-primary);
  }

  @media (min-width: 860px) {
    .nav-logo {
      justify-self: start;
    }
  }

  .nav-logo-svg {
    height: 38px;
    width: auto;
    color: var(--color-text-primary);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.7));
    transition: transform var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .nav-logo:hover .nav-logo-svg {
    color: var(--color-accent-ghost);
    transform: scale(1.05);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 2.75rem;
  }

  @media (min-width: 860px) {
    .nav-links {
      display: flex;
      justify-self: center;
    }
  }

  .nav-right {
    display: none;
  }

  @media (min-width: 860px) {
    .nav-right {
      display: block;
      justify-self: end;
      visibility: hidden;
      width: 1px;
    }
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: rgba(240, 237, 230, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    transition: color var(--duration-fast) ease, 
                letter-spacing var(--duration-fast) ease,
                text-shadow var(--duration-fast) ease;
    position: relative;
    padding: 0.25rem 0;
    text-transform: uppercase;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
    letter-spacing: 0.25em;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.4), 0 1px 6px rgba(0, 0, 0, 0.8);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1px;
    background-color: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
    transition: width var(--duration-fast) var(--ease-cinematic);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 860px) {
    .mobile-toggle {
      display: none;
    }
  }

  .toggle-bar {
    width: 24px;
    height: 1px;
    background-color: var(--color-text-primary);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                background-color var(--duration-fast) ease;
    transform-origin: center;
  }

  .mobile-toggle[aria-expanded="true"] .toggle-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .toggle-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    top: 60px;
    left: 0;
    width: 100%;
    height: calc(100vh - 60px);
    background: rgba(6, 6, 6, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: calc(var(--z-header) - 1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.35s ease;
    pointer-events: none;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.25rem;
    width: 100%;
    max-width: 320px;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    color: rgba(240, 237, 230, 0.82);
    padding: 0.5rem 1rem;
    text-transform: uppercase;
    transition: color var(--duration-fast) ease,
                letter-spacing var(--duration-fast) ease;
    position: relative;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    color: #ffffff;
    letter-spacing: 0.32em;
  }

  .link-home-cross {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    margin-bottom: 0.25rem;
    color: rgba(240, 237, 230, 0.7);
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .link-home-cross:hover,
  .link-home-cross:active {
    color: #ffffff;
    transform: scale(1.1);
    letter-spacing: 0.28em;
  }

  .tomb-cross-icon {
    width: 22px;
    height: 32px;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.8));
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      menu.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }

  // Detección de Sección Activa en el Menú Desktop
  if (desktopLinks.length > 0) {
    const sectionIds = Array.from(desktopLinks)
      .map(link => link.getAttribute('href')?.replace('#', ''))
      .filter((id): id is string => Boolean(id));

    const sections = sectionIds
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    const observer = new IntersectionObserver(
      (entries) => {
        // Si estamos cerca de la cima, limpiar activo
        if (window.scrollY < 200) {
          desktopLinks.forEach(link => link.classList.remove('active'));
          return;
        }

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const currentId = entry.target.id;
            desktopLinks.forEach(link => {
              const href = link.getAttribute('href')?.replace('#', '');
              if (href === currentId) {
                link.classList.add('active');
              } else {
                link.classList.remove('active');
              }
            });
          }
        });
      },
      {
        rootMargin: '-30% 0px -50% 0px',
        threshold: 0
      }
    );

    sections.forEach(sec => observer.observe(sec));

    window.addEventListener('scroll', () => {
      if (window.scrollY < 200) {
        desktopLinks.forEach(link => link.classList.remove('active'));
      }
    }, { passive: true });
  }
</script>
