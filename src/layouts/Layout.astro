---
import '../styles/variables.css';
import '../styles/reset.css';
import '../styles/grain.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "ANTTONIAS | Sitio Oficial",
  description = "Sitio oficial de Anttonias. Nuevo álbum '¿Qué tan romántica será la muerte?' disponible vía Lotus Records.",
  image = "/assets/images/anttonias-cementerio-03.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://anttonias.com');

const schemaMusicGroup = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": "Anttonias",
  "genre": ["Post-Punk", "Indie Rock", "Alternative Rock"],
  "url": "https://anttonias.com",
  "description": description,
  "member": [
    { "@type": "Person", "name": "Antonia Holzapfel", "roleName": "Vocalista" },
    { "@type": "Person", "name": "Diego Sanzana", "roleName": "Guitarrista" },
    { "@type": "Person", "name": "Oscar Concha", "roleName": "Guitarrista" },
    { "@type": "Person", "name": "Felipe Sanzana", "roleName": "Bajista" },
    { "@type": "Person", "name": "Agustín Plaza", "roleName": "Baterista" }
  ],
  "album": [
    {
      "@type": "MusicAlbum",
      "name": "¿Qué tan romántica será la muerte?",
      "datePublished": "2026-11-04",
      "recordLabel": "Lotus Records"
    },
    {
      "@type": "MusicAlbum",
      "name": "Anttonias",
      "datePublished": "2025-08-27"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es-CL">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#080808" />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content="es_CL" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Tipografías de Sistema & Fallback de Alta Fidelidad -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;800&family=JetBrains+Mono:wght@300;400;600&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaMusicGroup)} />
</head>
<body>
  <!-- Salto accesible para lectores de pantalla -->
  <a href="#contenido-principal" class="sr-only-focusable">Saltar al contenido principal</a>

  <!-- Textura física de película analógica 35mm -->
  <div class="film-grain-overlay" aria-hidden="true"></div>
  <div class="lens-vignette" aria-hidden="true"></div>

  <!-- Contenido -->
  <slot />

  <!-- Inercia Cinemática Lenis (Carga Mínima Optimizada) -->
  <script>
    import Lenis from 'lenis';

    // Singleton Lenis
    if (!(window as any).__anttoniasLenis) {
      const lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true,
        wheelMultiplier: 0.95
      });
      (window as any).__anttoniasLenis = lenis;

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Smooth scroll en enlaces ancla internos
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.length > 1) {
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              lenis.scrollTo(target as HTMLElement, { offset: -60, duration: 1.2 });
            }
          }
        });
      });
    }
  </script>

  <style is:global>
    .sr-only-focusable {
      position: absolute;
      top: -9999px;
      left: 1rem;
      background: var(--color-black);
      color: var(--color-text-primary);
      padding: 0.75rem 1.25rem;
      border: 1px solid var(--accent);
      z-index: 99999;
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }
    .sr-only-focusable:focus {
      top: 1rem;
    }
  </style>
</body>
</html>
